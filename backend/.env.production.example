# Modèle de configuration de PRODUCTION — copier en .env sur le serveur puis compléter.
# Ne jamais mettre ce fichier rempli dans Git.

APP_NAME="DemarchesTchad API"
APP_ENV=production
# Générer avec : php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Ndjamena
APP_URL=https://api.votre-domaine.td

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de données dédiée au projet (ne pas partager avec un autre site)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demarchestchad
DB_USERNAME=demarchestchad
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# Emails et rappels passent par la file d'attente : lancer « php artisan queue:work » en permanence.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Serveur d'envoi d'emails (fourni par votre hébergeur ou un service SMTP)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="contact@votre-domaine.td"
MAIL_FROM_NAME="DemarchesTchad"

# Adresse publique du site (liens dans les emails) et domaines autorisés à appeler l'API
FRONTEND_URL=https://www.votre-domaine.td
CORS_ALLOWED_ORIGINS=https://www.votre-domaine.td,https://votre-domaine.td
SANCTUM_STATEFUL_DOMAINS=www.votre-domaine.td,votre-domaine.td

# Assistant WhatsApp (API WhatsApp Cloud de Meta) — laisser vide pour le désactiver.
# Adresse du webhook à déclarer chez Meta : https://api.votre-domaine.td/api/v1/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Phrase secrète de votre choix, à recopier dans la configuration du webhook chez Meta
WHATSAPP_VERIFY_TOKEN=
# « Clé secrète de l'application » Meta (vérifie que les messages viennent bien de WhatsApp)
WHATSAPP_APP_SECRET=

# Secret partagé avec le serveur Next.js (même valeur que INTERNAL_API_KEY de frontend/.env.production.local).
# Générer : php -r "echo bin2hex(random_bytes(32));"   Laisser vide = le site est limité à 100 requêtes/minute comme un visiteur.
INTERNAL_API_KEY=
# Limite de lecture publique sans clé (cahier des charges : 100 requêtes/minute par adresse IP).
API_PUBLIC_PER_MINUTE=100
