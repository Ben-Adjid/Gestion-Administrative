# ==========================================
# EMAIL CONFIGURATION
# ==========================================

# Mail Driver: smtp, sendmail, mailgun, postmark, log
MAIL_DRIVER=smtp

# SMTP Host (votre serveur SMTP)
MAIL_HOST=smtp.gmail.com
# OU pour Mailgun
# MAIL_HOST=smtp.mailgun.org
# OU pour SendGrid
# MAIL_HOST=smtp.sendgrid.net

# SMTP Port (généralement 587 ou 465)
MAIL_PORT=587

# Email FROM (l'adresse d'envoi)
MAIL_FROM_ADDRESS=noreply@demarches.td
MAIL_FROM_NAME="DemarchesTchad"

# SMTP Authentification
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Encryption (tls ou ssl)
MAIL_ENCRYPTION=tls

# ==========================================
# QUEUE CONFIGURATION (Pour envoyer emails async)
# ==========================================

# Queue Driver: sync, database, redis, beanstalkd
QUEUE_CONNECTION=database

# ==========================================
# EXEMPLES DE CONFIGURATION
# ==========================================

# GMAIL (avec App Password):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=votre-app-password (16 caractères)
# MAIL_ENCRYPTION=tls

# MAILGUN:
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@demarches.mailgun.org
# MAIL_PASSWORD=votre-mailgun-password
# MAIL_ENCRYPTION=tls

# SENDGRID:
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.xxxxxxxxxxxx (votre API key)
# MAIL_ENCRYPTION=tls

# SMTP LOCALE (Mailtrap pour testing):
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=465
# MAIL_USERNAME=xxxxxxxxx
# MAIL_PASSWORD=xxxxxxxxx
# MAIL_ENCRYPTION=tls

# ==========================================
# ATTENTION:
# ==========================================
# 1. Créez un compte sur l'un des services ci-dessus
# 2. Générez les credentials (pas votre mot de passe principal!)
# 3. Copiez les valeurs dans votre .env
# 4. Testez avec: POST /api/v1/admin/email/test
# 5. Vérifiez que l'email est bien arrivé!
