# Configuration SMTP Brevo pour backend/.env.
# Laisser MAIL_MAILER=log jusqu'à ce que le login SMTP, la clé SMTP et l'expéditeur soient configurés.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
# Clé SMTP générée dans Brevo (ce n'est ni la clé API ni le login SMTP).
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@demarches.td
MAIL_FROM_NAME="DemarchesTchad"

# Après validation de la configuration, activer l'envoi réel :
# MAIL_MAILER=smtp

# Emails asynchrones en production (nécessite un worker Laravel actif)
QUEUE_CONNECTION=database
