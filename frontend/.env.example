NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="DemarchesTchad"
NEXT_PUBLIC_APP_ENV=local
# Adresse affichée sur les pages Contact et dans le pied de page (laisser vide pour la masquer)
NEXT_PUBLIC_CONTACT_EMAIL=
# Numéro WhatsApp de l'assistant (chiffres seulement, avec l'indicatif). Vide = boutons WhatsApp masqués.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Secret partagé entre l API et le serveur Next.js (même valeur des deux côtés ; php -r "echo bin2hex(random_bytes(32));").
INTERNAL_API_KEY=
