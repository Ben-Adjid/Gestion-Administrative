# Modèle de configuration de PRODUCTION du site — copier en .env.production.local puis compléter.
# Ces valeurs sont intégrées au moment de « npm run build » : reconstruire après chaque modification.

# Adresse de l'API Laravel (sans /api/v1)
NEXT_PUBLIC_API_URL=https://api.votre-domaine.td
# Adresse publique du site (sitemap, liens canoniques, partage)
NEXT_PUBLIC_APP_URL=https://www.votre-domaine.td
NEXT_PUBLIC_SITE_NAME="DemarchesTchad"
NEXT_PUBLIC_APP_ENV=production
# Email affiché sur la page Contact (laisser vide pour la masquer)
NEXT_PUBLIC_CONTACT_EMAIL=contact@votre-domaine.td
# Numéro WhatsApp de l'assistant (chiffres seulement, avec l'indicatif, ex. 23566000000). Vide = boutons WhatsApp masqués.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Secret partagé entre l API et le serveur Next.js (même valeur des deux côtés ; php -r "echo bin2hex(random_bytes(32));").
INTERNAL_API_KEY=
